# CompShield Backend - Environment Variables
# Copy to .env for local development

# App
APP_NAME=CompShield DPDP API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for local, PostgreSQL for Render)
# Local:
DATABASE_URL=sqlite:///./compshield.db
# Render PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/compshield

# CORS (frontend URLs)
CORS_ORIGINS=http://localhost:3000,https://compshield-dpdp.vercel.app

# Demo seed
SEED_DEMO_USER=true
